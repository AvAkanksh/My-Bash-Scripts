#!/usr/bin/env bash
#
# ytTranscript - fetch YouTube video/playlist transcripts using the
# youtube-transcript-api Python library (https://github.com/jdepoix/youtube-transcript-api)
#
# Single video : copies the transcript to the clipboard by default,
#                or saves it with -o/--output.
# Playlist     : fetches every video's transcript in parallel and, by
#                default, copies the combined transcript to the clipboard.
#                Use -d/--dir to save one .txt file per video, or
#                -s/--single (optionally with -o) to save one combined file.

set -uo pipefail

SCRIPT_NAME="$(basename "$0")"
CACHE_DIR="$HOME/.cache/yt-transcript"
VENV_DIR="$CACHE_DIR/venv"
PYTHON_BIN="$VENV_DIR/bin/python"
HELPER="$CACHE_DIR/transcript_helper.py"

LANG_CODE="en"
JOBS=10
OUTPUT=""
DIR_OUT=""
SINGLE=0
QUIET=0

# Proxy config (works around YouTube IP-blocking/rate-limiting), can also
# be set via env vars so you don't have to pass them on every run.
WEBSHARE_USER="${YTT_WEBSHARE_USER:-}"
WEBSHARE_PASS="${YTT_WEBSHARE_PASS:-}"
WEBSHARE_LOCATIONS="${YTT_WEBSHARE_LOCATIONS:-}"
PROXY_URL="${YTT_PROXY:-}"
PROXY_HTTP="${YTT_PROXY_HTTP:-}"
PROXY_HTTPS="${YTT_PROXY_HTTPS:-}"
NO_FREE_PROXY=0

usage() {
    cat <<EOF
${SCRIPT_NAME} - fetch YouTube transcripts (single video or full playlist)

USAGE:
    ${SCRIPT_NAME} [OPTIONS] <YouTube video or playlist URL>

DESCRIPTION:
    Fetches transcripts via the youtube-transcript-api Python library.
    A python venv with the library is created automatically on first run.

    Single video URL:
        - default             copy the transcript to the clipboard
        - -o/--output FILE    save the transcript to FILE instead

    Playlist URL (any URL containing "list="):
        - default             copy ALL transcripts (concatenated) to the clipboard
        - -d/--dir DIR        save one .txt file per video into DIR
        - -s/--single         save ONE combined .txt file (name it with -o,
                               otherwise it's named after the playlist)

OPTIONS:
    -o, --output FILE   Output file (single video, or combined playlist file)
    -d, --dir DIR       Save playlist transcripts as separate files in DIR
    -s, --single        Combine playlist transcripts into a single file
    -l, --lang CODE     Transcript language code (default: en)
    -j, --jobs N        Parallel workers for playlist fetching (default: 10)
    -q, --quiet         Suppress progress output
    -h, --help          Show this help and exit

PROXY (use if you hit "IP blocked"/"rate-limited" errors):
    By default, every video is fetched directly. If YouTube blocks that
    request and you haven't configured your own proxy, ${SCRIPT_NAME}
    AUTOMATICALLY retries it through a free proxy pulled from
    https://github.com/TheSpeedX/PROXY-List. Free proxies are unreliable
    (most are dead), so this can be slow and isn't guaranteed to work —
    it's a best-effort fallback, not a substitute for a real proxy.

    --no-free-proxy           Disable the automatic free-proxy fallback
                               (env: YTT_NO_FREE_PROXY=1)

    For a reliable fix, configure your own proxy — this also disables
    the free-proxy fallback automatically:

    --webshare-user USER      Webshare proxy username   (env: YTT_WEBSHARE_USER)
    --webshare-pass PASS      Webshare proxy password   (env: YTT_WEBSHARE_PASS)
    --webshare-locations CC,CC
                               Limit Webshare IPs to these country codes
                               (env: YTT_WEBSHARE_LOCATIONS)
    --proxy URL                Generic proxy URL, used for both http/https
                               (env: YTT_PROXY)
    --proxy-http URL          Generic HTTP proxy URL   (env: YTT_PROXY_HTTP)
    --proxy-https URL         Generic HTTPS proxy URL  (env: YTT_PROXY_HTTPS)

    Webshare (https://www.webshare.io) requires a "Residential" proxy
    package and is what the youtube-transcript-api README recommends,
    since it rotates IPs automatically. Any other HTTP/HTTPS/SOCKS proxy
    also works via --proxy / --proxy-http / --proxy-https. If both are
    set, Webshare takes priority.

EXAMPLES:
    ${SCRIPT_NAME} "https://youtu.be/dQw4w9WgXcQ"
        Copy this video's transcript to the clipboard.

    ${SCRIPT_NAME} -o transcript.txt "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
        Save this video's transcript to transcript.txt.

    ${SCRIPT_NAME} -d ./transcripts "https://www.youtube.com/playlist?list=PLxxxx"
        Save one .txt file per video into ./transcripts/.

    ${SCRIPT_NAME} -s -o all.txt -j 8 "https://www.youtube.com/playlist?list=PLxxxx"
        Fetch with 8 parallel workers, combine into all.txt.

    ${SCRIPT_NAME} --webshare-user U --webshare-pass P "https://youtu.be/dQw4w9WgXcQ"
        Fetch through a Webshare rotating residential proxy.
EOF
}

log() { [ "$QUIET" -eq 1 ] || echo "$@" >&2; }
die() { echo "❌ $*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
URL=""
while [ $# -gt 0 ]; do
    case "$1" in
        -o|--output)
            [ $# -ge 2 ] || die "$1 requires an argument"
            OUTPUT="$2"; shift 2 ;;
        -d|--dir)
            [ $# -ge 2 ] || die "$1 requires an argument"
            DIR_OUT="$2"; shift 2 ;;
        -s|--single)
            SINGLE=1; shift ;;
        -l|--lang)
            [ $# -ge 2 ] || die "$1 requires an argument"
            LANG_CODE="$2"; shift 2 ;;
        -j|--jobs)
            [ $# -ge 2 ] || die "$1 requires an argument"
            JOBS="$2"; shift 2 ;;
        -q|--quiet)
            QUIET=1; shift ;;
        --webshare-user)
            [ $# -ge 2 ] || die "$1 requires an argument"
            WEBSHARE_USER="$2"; shift 2 ;;
        --webshare-pass)
            [ $# -ge 2 ] || die "$1 requires an argument"
            WEBSHARE_PASS="$2"; shift 2 ;;
        --webshare-locations)
            [ $# -ge 2 ] || die "$1 requires an argument"
            WEBSHARE_LOCATIONS="$2"; shift 2 ;;
        --proxy)
            [ $# -ge 2 ] || die "$1 requires an argument"
            PROXY_URL="$2"; shift 2 ;;
        --proxy-http)
            [ $# -ge 2 ] || die "$1 requires an argument"
            PROXY_HTTP="$2"; shift 2 ;;
        --proxy-https)
            [ $# -ge 2 ] || die "$1 requires an argument"
            PROXY_HTTPS="$2"; shift 2 ;;
        --no-free-proxy)
            NO_FREE_PROXY=1; shift ;;
        -h|--help)
            usage; exit 0 ;;
        --)
            shift; break ;;
        -*)
            die "Unknown option: $1 (see --help)" ;;
        *)
            URL="$1"; shift ;;
    esac
done
[ -n "${1:-}" ] && URL="$1"

if [ -z "$URL" ]; then
    usage
    exit 1
fi

case "$JOBS" in
    ''|*[!0-9]*) die "--jobs must be a positive integer" ;;
esac
[ "$JOBS" -ge 1 ] || die "--jobs must be at least 1"

if [ -n "$WEBSHARE_USER" ] || [ -n "$WEBSHARE_PASS" ]; then
    [ -n "$WEBSHARE_USER" ] && [ -n "$WEBSHARE_PASS" ] \
        || die "--webshare-user and --webshare-pass must both be set"
fi

# Hand the chosen proxy config to the python helper via env vars, so it
# reaches every parallel worker too (they're spawned from this shell).
export YTT_WEBSHARE_USER="$WEBSHARE_USER"
export YTT_WEBSHARE_PASS="$WEBSHARE_PASS"
export YTT_WEBSHARE_LOCATIONS="$WEBSHARE_LOCATIONS"
export YTT_PROXY_HTTP="${PROXY_HTTP:-$PROXY_URL}"
export YTT_PROXY_HTTPS="${PROXY_HTTPS:-$PROXY_URL}"
export YTT_CACHE_DIR="$CACHE_DIR"

# By default, if YouTube blocks a request and no proxy was explicitly
# configured, automatically fall back to a free proxy from
# https://github.com/TheSpeedX/PROXY-List. Disable with --no-free-proxy.
if [ -n "$WEBSHARE_USER" ] || [ -n "$YTT_PROXY_HTTP" ] || [ -n "$YTT_PROXY_HTTPS" ]; then
    NO_FREE_PROXY=1
fi
export YTT_NO_FREE_PROXY="$NO_FREE_PROXY"

# ---------------------------------------------------------------------------
# Bootstrap python venv + youtube-transcript-api (once, cached)
# ---------------------------------------------------------------------------
write_helper() {
    mkdir -p "$CACHE_DIR"
    cat > "$HELPER" <<'PYEOF'
#!/usr/bin/env python3
import os
import sys

import concurrent.futures
import random
import time

import requests
from youtube_transcript_api import (
    YouTubeTranscriptApi,
    TranscriptsDisabled,
    NoTranscriptFound,
    VideoUnavailable,
    CouldNotRetrieveTranscript,
    RequestBlocked,
)
from youtube_transcript_api.proxies import GenericProxyConfig, WebshareProxyConfig

FREE_PROXY_LIST_URL = "https://raw.githubusercontent.com/TheSpeedX/PROXY-List/master/http.txt"
PROXY_PROBE_URL = "https://www.youtube.com/robots.txt"
PROXY_LIST_TTL = 6 * 3600
GOOD_PROXY_TTL = 10 * 60
PROBE_TIMEOUT = 5
MAX_PROBE_CANDIDATES = 40
PROBE_WORKERS = 20


def build_proxy_config():
    ws_user = os.environ.get("YTT_WEBSHARE_USER", "")
    ws_pass = os.environ.get("YTT_WEBSHARE_PASS", "")
    if ws_user and ws_pass:
        locations = os.environ.get("YTT_WEBSHARE_LOCATIONS", "")
        kwargs = {"proxy_username": ws_user, "proxy_password": ws_pass}
        if locations:
            kwargs["filter_ip_locations"] = [
                loc.strip() for loc in locations.split(",") if loc.strip()
            ]
        return WebshareProxyConfig(**kwargs)

    http_url = os.environ.get("YTT_PROXY_HTTP", "")
    https_url = os.environ.get("YTT_PROXY_HTTPS", "")
    if http_url or https_url:
        return GenericProxyConfig(
            http_url=http_url or https_url,
            https_url=https_url or http_url,
        )

    return None


def _cache_dir():
    d = os.environ.get("YTT_CACHE_DIR") or os.path.expanduser("~/.cache/yt-transcript")
    os.makedirs(d, exist_ok=True)
    return d


def _proxy_list_path():
    return os.path.join(_cache_dir(), "free_proxy_list.txt")


def _good_proxy_path():
    return os.path.join(_cache_dir(), "free_proxy_good.txt")


def _download_proxy_list():
    path = _proxy_list_path()
    try:
        if os.path.exists(path) and time.time() - os.path.getmtime(path) < PROXY_LIST_TTL:
            with open(path) as f:
                lines = [ln.strip() for ln in f if ln.strip()]
            if lines:
                return lines
    except OSError:
        pass
    resp = requests.get(FREE_PROXY_LIST_URL, timeout=10)
    resp.raise_for_status()
    lines = [ln.strip() for ln in resp.text.splitlines() if ln.strip()]
    try:
        with open(path, "w") as f:
            f.write("\n".join(lines))
    except OSError:
        pass
    return lines


def _read_good_proxy():
    path = _good_proxy_path()
    try:
        if time.time() - os.path.getmtime(path) < GOOD_PROXY_TTL:
            with open(path) as f:
                cached = f.read().strip()
            return cached or None
    except OSError:
        pass
    return None


def _write_good_proxy(proxy):
    try:
        with open(_good_proxy_path(), "w") as f:
            f.write(proxy)
    except OSError:
        pass


def _invalidate_good_proxy():
    try:
        os.remove(_good_proxy_path())
    except OSError:
        pass


def _probe(proxy):
    try:
        r = requests.get(
            PROXY_PROBE_URL,
            proxies={"http": f"http://{proxy}", "https": f"http://{proxy}"},
            timeout=PROBE_TIMEOUT,
        )
        return proxy if r.status_code == 200 else None
    except Exception:
        return None


def find_free_proxy(exclude=()):
    """Find a working proxy from TheSpeedX/PROXY-List (free, unauthenticated HTTP proxies)."""
    cached = _read_good_proxy()
    if cached and cached not in exclude and _probe(cached):
        return cached

    try:
        candidates = _download_proxy_list()
    except Exception as e:
        print(f"[warn] could not download free proxy list: {e}", file=sys.stderr)
        return None

    candidates = [c for c in candidates if c not in exclude]
    random.shuffle(candidates)
    candidates = candidates[:MAX_PROBE_CANDIDATES]
    with concurrent.futures.ThreadPoolExecutor(max_workers=PROBE_WORKERS) as ex:
        futures = {ex.submit(_probe, c) for c in candidates}
        for fut in concurrent.futures.as_completed(futures):
            result = fut.result()
            if result:
                for other in futures:
                    other.cancel()
                _write_good_proxy(result)
                return result
    return None


def clean_lines(snippets):
    lines = []
    prev = None
    for s in snippets:
        text = " ".join(s.text.split())
        if not text or text == prev:
            continue
        lines.append(text)
        prev = text
    return lines


def resolve(api, video_id, lang):
    """Fetch a transcript, falling back to any available language if `lang` isn't found."""
    try:
        return api.fetch(video_id, languages=[lang])
    except NoTranscriptFound:
        try:
            available = api.list(video_id)
            chosen = None
            for t in available:
                if not t.is_generated:
                    chosen = t
                    break
            if chosen is None:
                chosen = next(iter(available))
            print(
                f"[warn] '{lang}' not found for {video_id}; "
                f"using '{chosen.language_code}' instead",
                file=sys.stderr,
            )
            return chosen.fetch()
        except (TranscriptsDisabled, VideoUnavailable, CouldNotRetrieveTranscript):
            raise
        except Exception as e:
            print(f"[error] {video_id}: no transcript available ({e})", file=sys.stderr)
            sys.exit(1)


def main():
    if len(sys.argv) < 2:
        print("usage: transcript_helper.py <video_id> [lang]", file=sys.stderr)
        sys.exit(2)

    video_id = sys.argv[1]
    lang = sys.argv[2] if len(sys.argv) > 2 else "en"

    explicit_cfg = build_proxy_config()
    free_proxy_enabled = explicit_cfg is None and os.environ.get("YTT_NO_FREE_PROXY") != "1"

    try:
        transcript = resolve(YouTubeTranscriptApi(proxy_config=explicit_cfg), video_id, lang)
    except RequestBlocked:
        if not free_proxy_enabled:
            print(f"[error] {video_id}: blocked by YouTube (no proxy configured)", file=sys.stderr)
            sys.exit(1)

        transcript = None
        tried = set()
        max_attempts = 2
        for attempt in range(1, max_attempts + 1):
            print(f"[info] {video_id}: blocked — searching TheSpeedX/PROXY-List for a working free proxy (attempt {attempt}/{max_attempts})...", file=sys.stderr)
            proxy = find_free_proxy(exclude=tried)
            if not proxy:
                print(f"[error] {video_id}: blocked and no working free proxy found", file=sys.stderr)
                sys.exit(1)
            tried.add(proxy)
            print(f"[info] {video_id}: retrying via free proxy {proxy}", file=sys.stderr)
            try:
                free_cfg = GenericProxyConfig(http_url=f"http://{proxy}", https_url=f"http://{proxy}")
                transcript = resolve(YouTubeTranscriptApi(proxy_config=free_cfg), video_id, lang)
                break
            except TranscriptsDisabled:
                print(f"[error] {video_id}: transcripts are disabled for this video", file=sys.stderr)
                sys.exit(1)
            except VideoUnavailable:
                print(f"[error] {video_id}: video unavailable", file=sys.stderr)
                sys.exit(1)
            except (RequestBlocked, requests.exceptions.RequestException, OSError) as e:
                # This free proxy is dead/blocked/flaky either way — drop it and try another.
                _invalidate_good_proxy()
                if attempt == max_attempts:
                    print(f"[error] {video_id}: still failing after {max_attempts} free proxy attempts ({e})", file=sys.stderr)
                    sys.exit(1)
                continue
            except CouldNotRetrieveTranscript as e:
                print(f"[error] {video_id}: {e}", file=sys.stderr)
                sys.exit(1)
    except TranscriptsDisabled:
        print(f"[error] {video_id}: transcripts are disabled for this video", file=sys.stderr)
        sys.exit(1)
    except VideoUnavailable:
        print(f"[error] {video_id}: video unavailable", file=sys.stderr)
        sys.exit(1)
    except CouldNotRetrieveTranscript as e:
        print(f"[error] {video_id}: {e}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"[error] {video_id}: unexpected error: {e}", file=sys.stderr)
        sys.exit(1)

    for line in clean_lines(transcript.snippets):
        print(line)


if __name__ == "__main__":
    main()
PYEOF
}

ensure_env() {
    if [ ! -x "$PYTHON_BIN" ]; then
        command -v python3 >/dev/null 2>&1 || die "python3 is required but not found"
        log "⏳ Setting up python environment in $VENV_DIR (first run only)..."
        python3 -m venv "$VENV_DIR" || die "failed to create venv"
        "$VENV_DIR/bin/pip" install --quiet --upgrade pip >/dev/null 2>&1
        "$VENV_DIR/bin/pip" install --quiet youtube-transcript-api \
            || die "failed to install youtube-transcript-api"
    fi
    # Always rewrite so the helper stays in sync with this script's version.
    write_helper
}

command -v yt-dlp >/dev/null 2>&1 || die "yt-dlp is required but not found"
command -v jq >/dev/null 2>&1 || die "jq is required but not found"
ensure_env

# ---------------------------------------------------------------------------
# Clipboard helper
# ---------------------------------------------------------------------------
copy_to_clipboard() {
    local file="$1"
    local notify="notify-send"
    command -v notify-send >/dev/null 2>&1 || notify="echo"

    if command -v wl-copy >/dev/null 2>&1 && [ "${XDG_SESSION_TYPE:-}" = "wayland" ]; then
        wl-copy < "$file"
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus" \
            "$notify" "Transcript Copied" "Ready to paste!" --icon=edit-copy >/dev/null 2>&1
    elif command -v xclip >/dev/null 2>&1; then
        xclip -selection clipboard < "$file"
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus" \
            "$notify" "Transcript Copied" "Ready to paste!" --icon=edit-copy >/dev/null 2>&1
    elif command -v xsel >/dev/null 2>&1; then
        xsel --clipboard < "$file"
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus" \
            "$notify" "Transcript Copied" "Ready to paste!" --icon=edit-copy >/dev/null 2>&1
    else
        log "⚠️  No clipboard tool found (wl-copy/xclip/xsel) — printing to stdout instead:"
        cat "$file"
    fi
}

sanitize() {
    # strip characters that are awkward in filenames, collapse whitespace
    printf '%s' "$1" | tr '/\n\r\t' '    ' | sed -E 's/[<>:"\\|?*]+//g; s/ +/ /g; s/^ +| +$//g' | cut -c1-120
}

extract_video_id() {
    local url="$1"
    local id
    id=$(printf '%s' "$url" | grep -oE '(youtu\.be/|v=|/shorts/|/embed/)[A-Za-z0-9_-]{11}' | head -n1 | grep -oE '[A-Za-z0-9_-]{11}$')
    printf '%s' "$id"
}

TMP_ROOT=$(mktemp -d)
cleanup() { rm -rf "$TMP_ROOT"; }
trap cleanup EXIT

# ---------------------------------------------------------------------------
# Playlist mode
# ---------------------------------------------------------------------------
if printf '%s' "$URL" | grep -q 'list='; then
    log "📃 Fetching playlist info..."
    PLIST_JSON="$TMP_ROOT/playlist.json"
    yt-dlp --flat-playlist -J "$URL" > "$PLIST_JSON" 2>"$TMP_ROOT/yt-dlp.err"
    [ -s "$PLIST_JSON" ] || die "could not read playlist (see $TMP_ROOT/yt-dlp.err): $(cat "$TMP_ROOT/yt-dlp.err" 2>/dev/null)"

    PLAYLIST_TITLE=$(jq -r '.title // "playlist"' "$PLIST_JSON")
    COUNT=$(jq -r '.entries | length' "$PLIST_JSON")
    [ "$COUNT" -gt 0 ] || die "playlist has no videos"
    log "📃 Playlist: $PLAYLIST_TITLE ($COUNT videos) — using $JOBS parallel workers"

    ENTRIES_FILE="$TMP_ROOT/entries.tsv"
    jq -r '.entries[] | select(.id != null) | [.id, (.title // .id)] | @tsv' "$PLIST_JSON" > "$ENTRIES_FILE"

    WORK_DIR="$TMP_ROOT/work"
    mkdir -p "$WORK_DIR"

    WIDTH=${#COUNT}
    idx=0
    pids=()
    declare -A PID_IDX

    fetch_one() {
        local i="$1" vid="$2"
        "$PYTHON_BIN" "$HELPER" "$vid" "$LANG_CODE" \
            > "$WORK_DIR/$i.txt" 2> "$WORK_DIR/$i.err"
        echo $? > "$WORK_DIR/$i.rc"
    }

    while IFS=$'\t' read -r vid title; do
        idx=$((idx + 1))
        printf '%s' "$title" > "$WORK_DIR/$idx.title"
        fetch_one "$idx" "$vid" &
        pids+=($!)
        if [ "${#pids[@]}" -ge "$JOBS" ]; then
            wait -n 2>/dev/null
            # prune finished pids
            new_pids=()
            for p in "${pids[@]}"; do
                kill -0 "$p" 2>/dev/null && new_pids+=("$p")
            done
            pids=("${new_pids[@]}")
        fi
        log "  queued $idx/$COUNT: $title"
    done < "$ENTRIES_FILE"
    wait

    OK=0
    FAIL=0
    for f in "$WORK_DIR"/*.rc; do
        rc=$(cat "$f")
        if [ "$rc" -eq 0 ]; then OK=$((OK + 1)); else FAIL=$((FAIL + 1)); fi
    done
    log "✅ Done: $OK succeeded, $FAIL failed"
    if [ "$FAIL" -gt 0 ]; then
        for f in "$WORK_DIR"/*.err; do
            [ -s "$f" ] && sed 's/^/  /' "$f" >&2
        done
        if grep -qsl "blocked" "$WORK_DIR"/*.err 2>/dev/null; then
            if [ "$NO_FREE_PROXY" -eq 1 ]; then
                log "⚠️  YouTube blocked some requests. Retry later, lower -j (e.g. -j 3), drop --no-free-proxy, or set up a reliable proxy with --webshare-user/--webshare-pass (see --help)."
            else
                log "⚠️  YouTube blocked some requests (the automatic free-proxy fallback was tried too). Retry later, lower -j (e.g. -j 3), or set up a reliable proxy with --webshare-user/--webshare-pass (see --help)."
            fi
        fi
    fi

    if [ -n "$DIR_OUT" ]; then
        mkdir -p "$DIR_OUT" || die "could not create $DIR_OUT"
        for i in $(seq 1 "$COUNT"); do
            [ -s "$WORK_DIR/$i.txt" ] || continue
            title=$(cat "$WORK_DIR/$i.title" 2>/dev/null)
            name=$(sanitize "$title")
            num=$(printf "%0${WIDTH}d" "$i")
            cp "$WORK_DIR/$i.txt" "$DIR_OUT/${num}_${name}.txt"
        done
        log "💾 Saved $OK transcript file(s) to: $DIR_OUT"
    elif [ "$SINGLE" -eq 1 ] || [ -n "$OUTPUT" ]; then
        target="$OUTPUT"
        if [ -z "$target" ]; then
            target="$(sanitize "$PLAYLIST_TITLE")_transcripts.txt"
        fi
        : > "$target"
        for i in $(seq 1 "$COUNT"); do
            [ -s "$WORK_DIR/$i.txt" ] || continue
            title=$(cat "$WORK_DIR/$i.title" 2>/dev/null)
            {
                echo "===== [$i/$COUNT] $title ====="
                cat "$WORK_DIR/$i.txt"
                echo
            } >> "$target"
        done
        log "💾 Saved combined transcript to: $target"
    else
        COMBINED="$TMP_ROOT/combined.txt"
        : > "$COMBINED"
        for i in $(seq 1 "$COUNT"); do
            [ -s "$WORK_DIR/$i.txt" ] || continue
            title=$(cat "$WORK_DIR/$i.title" 2>/dev/null)
            {
                echo "===== [$i/$COUNT] $title ====="
                cat "$WORK_DIR/$i.txt"
                echo
            } >> "$COMBINED"
        done
        copy_to_clipboard "$COMBINED"
    fi

    exit 0
fi

# ---------------------------------------------------------------------------
# Single video mode
# ---------------------------------------------------------------------------
VIDEO_ID=$(extract_video_id "$URL")
[ -n "$VIDEO_ID" ] || die "could not extract a video ID from: $URL"

RESULT="$TMP_ROOT/result.txt"
ERR="$TMP_ROOT/result.err"
"$PYTHON_BIN" "$HELPER" "$VIDEO_ID" "$LANG_CODE" > "$RESULT" 2> "$ERR"
rc=$?
[ -s "$ERR" ] && sed 's/^/  /' "$ERR" >&2
if [ "$rc" -ne 0 ]; then
    if grep -qs "blocked" "$ERR" 2>/dev/null; then
        if [ "$NO_FREE_PROXY" -eq 1 ]; then
            log "⚠️  YouTube blocked the request. Retry later, drop --no-free-proxy, or set up a reliable proxy with --webshare-user/--webshare-pass (see --help)."
        else
            log "⚠️  YouTube blocked the request (the automatic free-proxy fallback was tried too). Retry later, or set up a reliable proxy with --webshare-user/--webshare-pass (see --help)."
        fi
    fi
    die "failed to fetch transcript for $VIDEO_ID"
fi
[ -s "$RESULT" ] || die "transcript for $VIDEO_ID was empty"

if [ -n "$OUTPUT" ]; then
    cp "$RESULT" "$OUTPUT"
    log "💾 Saved transcript to: $OUTPUT"
else
    copy_to_clipboard "$RESULT"
fi
